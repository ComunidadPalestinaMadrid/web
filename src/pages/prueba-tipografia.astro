  </section>
</BaseLayout>

<style is:global>
  .muestra { padding: 2rem 0 2.4rem; border-bottom: 1px solid var(--linea); }
  .muestra__nombre {
    margin: 0 0 1.2rem; font-family: var(--fuente); font-size: var(--t-lg);
    font-weight: 700; color: var(--tinta);
  }
  .muestra__nombre span {
    font-size: var(--t-xs); font-weight: 400; color: var(--texto-suave);
    letter-spacing: .06em; text-transform: uppercase; margin-left: .6rem;
  }
  .muestra__cuerpo { max-width: 68ch; }
  .muestra__cuerpo h2 { font-family: var(--fuente); font-weight: 700; line-height: 1.08; margin: 0 0 .6rem; }
  .muestra__cuerpo .entradilla { font-size: var(--t-lg); line-height: 1.4; color: var(--texto-suave); margin: 0 0 1rem; }
  .muestra__cuerpo p { margin: 0 0 1rem; }

  /* Lora (la actual) */
  [data-fuente="lora"] { font-family: "Lora", Georgia, serif; font-size: 17px; line-height: 1.72; }

  /* Libre Franklin */
  [data-fuente="libre"] { font-family: "Libre Franklin", system-ui, sans-serif; font-size: 17px; line-height: 1.66; font-weight: 400; letter-spacing: -.005em; }
  [data-fuente="libre"] strong { font-weight: 600; }

  /* Spectral */
  [data-fuente="spectral"] { font-family: "Spectral", Georgia, serif; font-size: 17px; line-height: 1.66; font-weight: 400; }
  [data-fuente="spectral"] strong { font-weight: 600; }

  /* Source Serif 4 */
  [data-fuente="source"] { font-family: "Source Serif 4", Georgia, serif; font-size: 17px; line-height: 1.66; font-weight: 400; }
  [data-fuente="source"] strong { font-weight: 600; }

  /* Merriweather */
  [data-fuente="merri"] { font-family: "Merriweather", Georgia, serif; font-size: 16px; line-height: 1.72; font-weight: 400; }
  [data-fuente="merri"] strong { font-weight: 700; }
</style>
