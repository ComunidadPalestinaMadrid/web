---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath } from '../../i18n/utils';
---
<BaseLayout lang="ar" title="الصفحة غير موجودة">
  <section class="seccion">
    <div class="contenedor centrado">
      <span class="eyebrow">خطأ 404</span>
      <h1>الصفحة غير موجودة</h1>
      <p class="entradilla">عذرًا، الصفحة التي تبحث عنها غير موجودة أو تغيّر عنوانها.</p>
      <p class="boton-fila" style="justify-content:center">
        <a class="boton boton--primario" href={localizePath('/', 'ar')}>العودة إلى الرئيسية</a>
        <a class="boton boton--fantasma" href={localizePath('/publicaciones', 'ar')}>عرض المنشورات</a>
      </p>
    </div>
  </section>
</BaseLayout>
