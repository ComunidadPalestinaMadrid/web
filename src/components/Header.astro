---
import { NAV } from '../data/nav';
import { SITE } from '../data/site';
import { useTranslations, localizePath, currentPath, withBase } from '../i18n/utils';

const t = useTranslations();
const base = currentPath(Astro.url);
const esActivo = (p: string) => (p === '/' ? base === '/' : base === p || base.startsWith(p + '/'));
---
<header class="cabecera">
  <div class="filete" aria-hidden="true"></div>
  <div class="contenedor cabecera__interior">
    <a class="marca" href={localizePath('/')}>
      <img src={withBase('/images/logo.png')} alt="" width="44" height="44" />
      <span class="marca__texto">
        <span class="marca__nombre">{SITE.corto}</span>
        <span class="marca__sub">{SITE.nombreLargo}</span>
      </span>
    </a>
    <input type="checkbox" id="menu-principal" class="menu-toggle" />
    <label for="menu-principal" class="menu-boton" title={t('common.abrirMenu')}>
      <span class="barra"></span><span class="barra"></span><span class="barra"></span>
      <span class="salto">{t('common.abrirMenu')}</span>
    </label>
    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav__lista">
        {NAV.map((item) =>
          'children' in item ? (
            <li class="nav__grupo">
              <button
                type="button"
                aria-haspopup="true"
                class={'nav__enlace nav__enlace--grupo' + (item.children.some((c) => esActivo(c.path)) ? ' nav__enlace--activo' : '')}
              >
                {t(item.key)}
                <span class="nav__flecha" aria-hidden="true">▾</span>
              </button>
              <ul class="nav__sub">
                {item.children.map((hijo) => (
                  <li>
                    <a class="nav__enlace" href={localizePath(hijo.path)} aria-current={esActivo(hijo.path) ? 'page' : undefined}>
                      {t(hijo.key)}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a class="nav__enlace" href={localizePath(item.path)} aria-current={esActivo(item.path) ? 'page' : undefined}>
                {t(item.key)}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>
  </div>
</header>
