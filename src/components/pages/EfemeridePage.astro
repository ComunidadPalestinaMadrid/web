---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import { formatDiaMes, proximaFechaEfemeride, type Efemeride } from '../../data/eventos';
import { useTranslations, localizePath, withBase } from '../../i18n/utils';

interface Props { efemeride: Efemeride; }
const { efemeride } = Astro.props;
const t = useTranslations();
const proxima = proximaFechaEfemeride(efemeride);
const fechaLarga = proxima.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const fechaLargaCap = fechaLarga.charAt(0).toUpperCase() + fechaLarga.slice(1);
const diaMes = formatDiaMes(efemeride.dia, efemeride.mes);
// Cuerpo largo en HTML si lo hay; si no, el resumen en un parrafo.
const cuerpo = efemeride.contenido ?? '<p>' + efemeride.descripcion + '</p>';
---
<BaseLayout title={efemeride.titulo} description={efemeride.descripcion.slice(0, 155)}>
  <PaginaCabecera
    eyebrow={t('cal.efemeride')}
    titulo={efemeride.titulo}
    entradilla={diaMes + (efemeride.anio ? ' · ' + t('cal.conmemora') + ' ' + efemeride.anio : '')}
    migas={[
      { texto: t('nav.inicio'), href: localizePath('/') },
      { texto: t('cal.titulo'), href: localizePath('/calendario') },
      { texto: efemeride.titulo }
    ]}
  />
  <section class="seccion">
    <div class="contenedor">

      {efemeride.imagen && (
        <figure class="efemeride-imagen">
          <img
            src={withBase(efemeride.imagen)}
            alt={efemeride.altImagen ?? efemeride.titulo}
            loading="lazy"
            decoding="async"
          />
          {efemeride.creditoImagen && <figcaption>{efemeride.creditoImagen}</figcaption>}
        </figure>
      )}

      <div class="prosa prosa--ancho" set:html={cuerpo} />

      <p class="mt-3">
        <a class="boton boton--fantasma" href={localizePath('/calendario')}>← {t('cal.volverAgenda')}</a>
      </p>
    </div>
  </section>
</BaseLayout>
