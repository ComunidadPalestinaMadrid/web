---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CAMPANA } from '../../data/campana';

const eur = (n: number) => n.toLocaleString('es-ES') + ' €';
const pct = Math.min(100, (CAMPANA.recaudado / CAMPANA.objetivoOptimo) * 100);
const pctMinimo = (CAMPANA.objetivoMinimo / CAMPANA.objetivoOptimo) * 100;
const fecha = new Date(CAMPANA.actualizado + 'T12:00:00').toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric'
});
const idVideo = (CAMPANA.videoUrl.match(/(?:youtu\.be\/|[?&]v=|embed\/|shorts\/)([\w-]{11})/) || [])[1] || '';
const tieneIban = CAMPANA.cuenta.iban.trim().length > 0;
const limite = new Date(CAMPANA.fechaLimite + 'T23:59:59');
const fechaLimite = limite.toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });
const campanaAbierta = new Date() <= limite;
---
<BaseLayout title={CAMPANA.titulo} description={CAMPANA.descripcion}>

  <!-- Cabecera de la campana -->
  <section class="campana-hero">
    <div class="contenedor campana-hero__grid">
      <div class="campana-hero__texto">
        <span class="campana-plazo">
          <span class="campana-plazo__punto" aria-hidden="true"></span>
          {campanaAbierta ? 'Campaña abierta hasta el ' + fechaLimite : 'Campaña finalizada el ' + fechaLimite}
        </span>
        <span class="eyebrow">Campaña de reagrupación familiar</span>
        <h1 class="campana-hero__titulo">{CAMPANA.titulo}</h1>
        <p class="campana-hero__sub">{CAMPANA.subtitulo}</p>
        <p class="boton-fila">
          <a class="boton boton--primario" href="#donar">Cómo donar</a>
          <a class="boton boton--fantasma" href="#recaudacion">Ver la recaudación</a>
        </p>
      </div>

      <aside class="campana-importe" id="recaudacion">
        <p class="campana-importe__cifra">{eur(CAMPANA.recaudado)}</p>
        <p class="campana-importe__de">recaudados de un mínimo de <strong>{eur(CAMPANA.objetivoMinimo)}</strong></p>

        <div
          class="barra"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={CAMPANA.objetivoOptimo}
          aria-valuenow={CAMPANA.recaudado}
          aria-valuetext={eur(CAMPANA.recaudado) + ' de ' + eur(CAMPANA.objetivoMinimo)}
          aria-label="Recaudación de la campaña"
        >
          <span class="barra__relleno" style={`width: ${pct.toFixed(2)}%`}></span>
          <span class="barra__marca" style={`left: ${pctMinimo.toFixed(2)}%`} title={`Objetivo mínimo: ${eur(CAMPANA.objetivoMinimo)}`}></span>
        </div>

        <p class="barra__leyenda">
          <span>Mínimo {eur(CAMPANA.objetivoMinimo)}</span>
          <span>Óptimo {eur(CAMPANA.objetivoOptimo)}</span>
        </p>

        <p class="campana-importe__nota">
          Actualizado cada día a las 12:00 h · última revisión: {fecha}
        </p>

        <a class="boton boton--primario campana-importe__boton" href="#donar">Donar ahora</a>
      </aside>
    </div>
  </section>

  <!-- Video de la campana -->
  <section class="campana-bloque">
    <div class="contenedor">
      {idVideo ? (
        <div class="video-embed">
          <iframe
            src={'https://www.youtube-nocookie.com/embed/' + idVideo}
            title="Vídeo de la campaña Reencuentros que salvan vidas"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"></iframe>
        </div>
      ) : (
        <div class="campana-hueco campana-hueco--video">
          <span class="campana-hueco__etiqueta">Vídeo de la campaña</span>
          <span class="campana-hueco__nota">Espacio reservado</span>
        </div>
      )}
    </div>
  </section>

  <!-- Banner horizontal -->
  <div class="contenedor">
    {CAMPANA.banner ? (
      <img class="campana-banner" src={CAMPANA.banner} alt="Banner de la campaña" loading="lazy" decoding="async" />
    ) : (
      <div class="campana-hueco campana-hueco--banner">
        <span class="campana-hueco__etiqueta">Banner horizontal</span>
        <span class="campana-hueco__nota">Espacio reservado</span>
      </div>
    )}
  </div>

  <!-- Como donar -->
  <section class="seccion" id="donar">
    <div class="contenedor">
      <div class="campana-donar">
        <h2 class="campana-donar__titulo">Cómo donar</h2>
        <p class="campana-donar__intro">Haz una transferencia a esta cuenta con los datos que aparecen abajo. Es la única vía habilitada para esta campaña.</p>

        <dl class="campana-datos">
          <div class="campana-datos__fila">
            <dt>Beneficiario</dt>
            <dd><strong>{CAMPANA.cuenta.beneficiario}</strong></dd>
          </div>
          <div class="campana-datos__fila">
            <dt>Concepto</dt>
            <dd class="campana-datos__concepto">{CAMPANA.cuenta.concepto}</dd>
          </div>
          <div class="campana-datos__fila campana-datos__fila--iban">
            <dt>Número de cuenta</dt>
            <dd>
              {tieneIban ? (
                <span class="campana-datos__iban">{CAMPANA.cuenta.iban}</span>
              ) : (
                <span class="campana-datos__pendiente">Pendiente de publicar</span>
              )}
            </dd>
          </div>
        </dl>

        <p class="campana-donar__aviso">
          Escribe el concepto <strong>tal cual</strong>, sustituyendo <strong>[TU NOMBRE]</strong> por el tuyo: es lo que nos permite avisarte y, si lo deseas, incluirte en la web de agradecimientos.
        </p>
      </div>
    </div>
  </section>

  <!-- Texto de la campana -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="prosa prosa--ancho" set:html={CAMPANA.contenido} />

      <p class="campana-cierre">
        <a class="boton boton--primario" href="#donar">Quiero ayudar</a>
      </p>
    </div>
  </section>
</BaseLayout>
