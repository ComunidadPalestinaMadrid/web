---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import Buscador from '../Buscador.astro';
import { publicaciones, ETIQUETA_TIPO, CLASE_TIPO } from '../../data/publicaciones';
import { CONTACTO_PRENSA } from '../../data/prensa';
import { SITE } from '../../data/site';
import { useTranslations, localizePath, formatFecha } from '../../i18n/utils';

const t = useTranslations();
// Sala de prensa: notas de prensa y comunicados, del mas reciente al mas antiguo
const notas = publicaciones.filter((p) => p.tipo === 'nota-prensa' || p.tipo === 'comunicado');
---
<BaseLayout title={t('nav.salaPrensa')} description={t('prensa.salaIntro')}>
  <PaginaCabecera
    eyebrow={t('nav.prensa')}
    titulo={t('nav.salaPrensa')}
    entradilla={t('prensa.salaIntro')}
    migas={[
      { texto: t('nav.inicio'), href: localizePath('/') },
      { texto: t('nav.prensa') },
      { texto: t('nav.salaPrensa') }
    ]}
  />
  <section class="seccion" data-buscador-scope>
    <div class="contenedor dos-columnas">
      <div>
        <Buscador placeholder={t('prensa.buscar')} vacio={t('prensa.sinResultados')} />
        <ul class="lista-prensa">
          {notas.map((n) => (
            <li class="nota-prensa" data-buscable={n.title + ' ' + n.resumen + ' ' + n.date}>
              <p class="nota-prensa__meta">
                <span class="nota-prensa__fecha">{formatFecha(n.date)}</span>
                <span class={'etiqueta ' + CLASE_TIPO[n.tipo]}>{t(ETIQUETA_TIPO[n.tipo])}</span>
              </p>
              <h3 class="nota-prensa__titulo">
                <a href={localizePath('/publicaciones/' + n.slug)}>{n.title}</a>
              </h3>
              <p class="nota-prensa__resumen">{n.resumen}</p>
              <p class="nota-prensa__pie">
                <a class="boton boton--texto boton--pequeno" href={localizePath('/publicaciones/' + n.slug)}>{t('common.leerMas')} →</a>
              </p>
            </li>
          ))}
        </ul>
      </div>

      <aside>
        <div class="panel panel--sticky">
          <h3>{t('prensa.contactoMedios')}</h3>
          <ul class="lista-enlaces pieza-pequena">
            <li><a href={'mailto:' + CONTACTO_PRENSA.email}>{CONTACTO_PRENSA.email}</a></li>
            <li><a href={SITE.instagram.url} rel="noopener" target="_blank">{SITE.instagram.usuario}</a></li>
          </ul>
          <p class="pieza-pequena texto-suave">{CONTACTO_PRENSA.idiomas}</p>
          <h3 class="mt-3">{t('nav.apariciones')}</h3>
          <p class="pieza-pequena">
            {'Consulta los medios que se han hecho eco de la actividad de la asociación.'}
          </p>
          <a class="boton boton--fantasma boton--pequeno" href={localizePath('/prensa/apariciones')}>{t('nav.apariciones')} →</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
