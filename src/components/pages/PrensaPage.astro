---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import TarjetaPublicacion from '../TarjetaPublicacion.astro';
import { notasDePrensa } from '../../data/publicaciones';
import { GRUPOS_PRENSA, CONTACTO_PRENSA } from '../../data/prensa';
import { SITE } from '../../data/site';
import { useTranslations, localizePath, formatFecha, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const notas = notasDePrensa();
---
<BaseLayout lang={lang} title={t('prensa.titulo')} description={t('prensa.intro')}>
  <PaginaCabecera
    eyebrow={t('nav.prensa')}
    titulo={t('prensa.titulo')}
    entradilla={t('prensa.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/', lang) }, { texto: t('prensa.titulo') }]}
  />
  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div>
        <div class="seccion-cabecera">
          <h2>{t('prensa.notas')}</h2>
        </div>
        <div class="rejilla rejilla--2">
          {notas.map((n) => <TarjetaPublicacion pub={n} lang={lang} />)}
        </div>

        <div class="seccion-cabecera mt-3">
          <h2>{t('prensa.medios')}</h2>
          <p class="entradilla">
            {lang === 'ar'
              ? 'مجموعة من المتابعات الإعلامية لأنشطة الجمعية (أرشيف 2017).'
              : 'Recopilación de medios que se hicieron eco de los actos convocados o en los que participó la asociación.'}
          </p>
        </div>
        {GRUPOS_PRENSA.map((g) => (
          <div class="mb-3">
            <h3>{g.evento}</h3>
            <p class="pieza-pequena texto-suave">{g.descripcion}</p>
            <ul class="lista-enlaces">
              {g.menciones.map((m) => (
                <li>
                  <a href={m.url} rel="noopener nofollow" target="_blank">{m.medio}: {m.titulo} ↗</a>
                  <div class="pieza-pequena texto-suave">{formatFecha(m.fecha, lang)}</div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <aside>
        <div class="panel panel--sticky">
          <h3>{t('prensa.contactoMedios')}</h3>
          <ul class="lista-enlaces pieza-pequena">
            <li><a href={'mailto:' + CONTACTO_PRENSA.email}>{CONTACTO_PRENSA.email}</a></li>
            <li><a href={SITE.instagram.url} rel="noopener" target="_blank">{SITE.instagram.usuario}</a></li>
          </ul>
          <p class="pieza-pequena texto-suave mb-0">{CONTACTO_PRENSA.idiomas}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
