---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import { SITE } from '../../data/site';
import { useTranslations, localizePath } from '../../i18n/utils';

const t = useTranslations();

// Modalidades de socio, presentadas como tarjetas de precios
const modalidades = [
  {
    clave: 'participa.pleno' as const,
    formulario: SITE.formularioAfiliacion,
    cuando: 'Personas palestinas y sus cónyuges',
    cuota: '5',
    periodo: 'cuota mensual',
    incluye: [
    'Participación en todas las actividades de la asociación',  
    'Derecho a voto en la Asamblea'
    ],
    excluye: [] as string[],
    destacado: true
  },
  {
    clave: 'participa.simpatizante' as const,
    formulario: SITE.formularioSimpatizante,
    cuando: 'Cualquier persona solidaria con la causa palestina',
    cuota: '0',
    periodo: '',
    incluye: [
      'Participación en todas las actividades de la asociación',
      'Aportación voluntaria de 5€'
    ],
    excluye: [] as string[],
    destacado: false
  }
];

const donacionesIntro = 'Si quieres apoyar económicamente el trabajo de la asociación, estas son las vías disponibles:';

/* Datos de la transferencia, el bloque principal */
const transferencia = {
  beneficiario: 'ASOC. COM. HISPANO PALESTINA (JERUSALEN)',
  concepto: 'DONACION + [TU NOMBRE]',
  cuenta: 'ES45 2100 2566 9813 0078 8761'
};

/* Las otras dos vías, debajo y en dos columnas */
const otrasVias = [
  { titulo: 'Bizum', texto: 'Número para donaciones: [PENDIENTE].' },
  { titulo: 'Donaciones en especie', texto: 'Materiales, servicios o espacios: escríbenos y lo coordinamos.' }
];
---
<BaseLayout title={t('participa.titulo')} description={t('participa.intro')}>
  <PaginaCabecera
    eyebrow={t('nav.participa')}
    titulo={t('participa.titulo')}
    entradilla={t('participa.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/') }, { texto: t('participa.titulo') }]}
  />

  <!-- Modalidades de socio -->
  <section class="seccion">
    <div class="contenedor">
      <div class="precios">
        {modalidades.map((m) => (
          <div class={'precio' + (m.destacado ? ' precio--destacado' : '')}>
            <h3 class="precio__nombre">{t(m.clave)}</h3>
            <p class="precio__cuando">{m.cuando}</p>
            <p class="precio__importe">
              <span class="precio__cifra">{m.cuota}€</span>
              <span class="precio__periodo">{m.periodo}</span>
            </p>
            <ul class="precio__lista">
              {m.incluye.map((x) => <li>{x}</li>)}
              {m.excluye.map((x) => <li class="precio__no">{x}</li>)}
            </ul>
            <a class="boton boton--primario" href={m.formulario} target="_blank" rel="noopener">
              {t('participa.formulario')} ↗
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donaciones -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('participa.donaciones')}</h2>
        <p class="entradilla">{donacionesIntro}</p>
      </div>
      <div class="donacion-transferencia">
        <h3 class="donacion-transferencia__titulo">Transferencia bancaria</h3>
        <dl class="donacion-datos">
          <div>
            <dt>Beneficiario</dt>
            <dd>
              <span class="donacion-datos__valor">{transferencia.beneficiario}</span>
              <button type="button" class="copiar" data-copiar={transferencia.beneficiario} aria-label="Copiar beneficiario">
                <span class="copiar__icono"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></span>
                <span class="copiar__hecho"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 6.5"/></svg></span>
              </button>
            </dd>
          </div>
          <div>
            <dt>Concepto</dt>
            <dd>
              <span class="donacion-datos__valor">{transferencia.concepto}</span>
              <button type="button" class="copiar" data-copiar={transferencia.concepto} aria-label="Copiar concepto">
                <span class="copiar__icono"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></span>
                <span class="copiar__hecho"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 6.5"/></svg></span>
              </button>
            </dd>
          </div>
          <div>
            <dt>Número de cuenta</dt>
            <dd class="donacion-datos__iban">
              <span class="donacion-datos__valor">{transferencia.cuenta}</span>
              <button type="button" class="copiar" data-copiar={transferencia.cuenta} aria-label="Copiar número de cuenta">
                <span class="copiar__icono"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></span>
                <span class="copiar__hecho"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 6.5"/></svg></span>
              </button>
            </dd>
          </div>
        </dl>
      </div>

      <div class="rejilla rejilla--2">
        {otrasVias.map((d) => (
          <div class="panel">
            <h3>{d.titulo}</h3>
            <p class="pieza-pequena mb-0">{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

<script>
  // Botones de copiar de los datos de la transferencia
  document.querySelectorAll('[data-copiar]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const texto = boton.getAttribute('data-copiar') || '';
      try {
        await navigator.clipboard.writeText(texto);
        boton.classList.add('copiar--hecho');
        setTimeout(() => boton.classList.remove('copiar--hecho'), 1600);
      } catch {
        /* sin permiso de portapapeles: no hacemos nada */
      }
    });
  });
</script>
</BaseLayout>
