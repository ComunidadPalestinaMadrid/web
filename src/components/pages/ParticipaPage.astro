---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import { SITE } from '../../data/site';
import { useTranslations, localizePath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const intro = ar
  ? 'هناك شكلان للانضمام إلى الجمعية. كلاهما يشارك في الأنشطة ويستخدمان نفس نموذج الانتساب؛ والفرق بينهما هو حق التصويت في الجمعية العامة.'
  : 'Hay dos formas de formar parte de la asociación. Ambas participan en las actividades y comparten el mismo formulario de afiliación; la diferencia entre ellas es el derecho a voto en la Asamblea.';

// Modalidades de socio, presentadas como tarjetas de precios
const modalidades = ar ? [
  {
    clave: 'participa.pleno' as const,
    cuando: 'للأشخاص الفلسطينيين وأزواجهم',
    periodo: 'رسوم سنوية',
    incluye: [
      'حق التصويت في الجمعية العامة',
      'المشاركة في جميع أنشطة الجمعية'
    ],
    excluye: [] as string[],
    destacado: true
  },
  {
    clave: 'participa.simpatizante' as const,
    cuando: 'أي شخص متضامن مع القضية الفلسطينية',
    periodo: 'رسوم اختيارية',
    incluye: [
      'المشاركة في جميع أنشطة الجمعية',
      'مساهمة تطوعية بـ 5 يورو'
    ],
    excluye: ['دون حق التصويت في الجمعية العامة'],
    destacado: false
  }
] : [
  {
    clave: 'participa.pleno' as const,
    cuando: 'Personas palestinas y sus cónyuges',
    periodo: 'cuota anual',
    incluye: [
      'Derecho a voto en la Asamblea',
      'Participación en todas las actividades de la asociación'
    ],
    excluye: [] as string[],
    destacado: true
  },
  {
    clave: 'participa.simpatizante' as const,
    cuando: 'Cualquier persona solidaria con la causa palestina',
    periodo: 'cuota opcional',
    incluye: [
      'Participación en todas las actividades de la asociación',
      'Aportación voluntaria de 5 €'
    ],
    excluye: ['Sin voto en la Asamblea'],
    destacado: false
  }
];

const donacionesIntro = ar
  ? 'إذا رغبت في دعم عمل الجمعية ماليًا، فهذه هي الطرق المتاحة:'
  : 'Si quieres apoyar económicamente el trabajo de la asociación, estas son las vías disponibles:';

const donaciones = ar ? [
  { titulo: 'تحويل بنكي', texto: 'الحساب البنكي للجمعية: [قيد الإكمال].' },
  { titulo: 'بيزوم', texto: 'رقم بيزوم للتبرعات: [قيد الإكمال].' },
  { titulo: 'تبرعات عينية', texto: 'مواد أو خدمات أو مساحات: راسلنا وسننسّق معك.' }
] : [
  { titulo: 'Transferencia bancaria', texto: 'Cuenta de la asociación: [PENDIENTE].' },
  { titulo: 'Bizum', texto: 'Número para donaciones: [PENDIENTE].' },
  { titulo: 'Donaciones en especie', texto: 'Materiales, servicios o espacios: escríbenos y lo coordinamos.' }
];
---
<BaseLayout lang={lang} title={t('participa.titulo')} description={t('participa.intro')}>
  <PaginaCabecera
    eyebrow={t('nav.participa')}
    titulo={t('participa.titulo')}
    entradilla={t('participa.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/', lang) }, { texto: t('participa.titulo') }]}
  />

  <!-- Modalidades de socio -->
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('participa.tipos')}</h2>
        <p class="entradilla">{intro}</p>
      </div>

      <div class="precios">
        {modalidades.map((m) => (
          <div class={'precio' + (m.destacado ? ' precio--destacado' : '')}>
            <h3 class="precio__nombre">{t(m.clave)}</h3>
            <p class="precio__cuando">{m.cuando}</p>
            <p class="precio__importe">
              <span class="precio__cifra">5 €</span>
              <span class="precio__periodo">{m.periodo}</span>
            </p>
            <ul class="precio__lista">
              {m.incluye.map((x) => <li>{x}</li>)}
              {m.excluye.map((x) => <li class="precio__no">{x}</li>)}
            </ul>
            <a class="boton boton--primario" href={SITE.formularioAfiliacion} target="_blank" rel="noopener">
              {t('participa.formulario')} ↗
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donaciones -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('participa.donaciones')}</h2>
        <p class="entradilla">{donacionesIntro}</p>
      </div>
      <div class="rejilla rejilla--3">
        {donaciones.map((d) => (
          <div class="panel">
            <h3>{d.titulo}</h3>
            <p class="pieza-pequena mb-0">{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
