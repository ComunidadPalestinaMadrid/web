---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import { SITE } from '../../data/site';
import { useTranslations, localizePath } from '../../i18n/utils';

const t = useTranslations();

// Modalidades de socio, presentadas como tarjetas de precios
const modalidades = [
  {
    clave: 'participa.pleno' as const,
    cuando: 'Personas palestinas y sus cónyuges',
    periodo: 'cuota mensual',
    incluye: [
    'Participación en todas las actividades de la asociación',  
    'Derecho a voto en la Asamblea'
    ],
    excluye: [] as string[],
    destacado: true
  },
  {
    clave: 'participa.simpatizante' as const,
    cuando: 'Cualquier persona solidaria con la causa palestina',
    periodo: 'cuota mensual voluntaria',
    incluye: [
      'Participación en todas las actividades de la asociación',
      'Aportación voluntaria de 5€'
    ],
    excluye: [] as string[],
    destacado: false
  }
];

const donacionesIntro = 'Si quieres apoyar económicamente el trabajo de la asociación, estas son las vías disponibles:';

const donaciones = [
  { titulo: 'Transferencia bancaria', texto: 'Cuenta de la asociación: [PENDIENTE].' },
  { titulo: 'Bizum', texto: 'Número para donaciones: [PENDIENTE].' },
  { titulo: 'Donaciones en especie', texto: 'Materiales, servicios o espacios: escríbenos y lo coordinamos.' }
];
---
<BaseLayout title={t('participa.titulo')} description={t('participa.intro')}>
  <PaginaCabecera
    eyebrow={t('nav.participa')}
    titulo={t('participa.titulo')}
    entradilla={t('participa.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/') }, { texto: t('participa.titulo') }]}
  />

  <!-- Modalidades de socio -->
  <section class="seccion">
    <div class="contenedor">
      <div class="precios">
        {modalidades.map((m) => (
          <div class={'precio' + (m.destacado ? ' precio--destacado' : '')}>
            <h3 class="precio__nombre">{t(m.clave)}</h3>
            <p class="precio__cuando">{m.cuando}</p>
            <p class="precio__importe">
              <span class="precio__cifra">5 €</span>
              <span class="precio__periodo">{m.periodo}</span>
            </p>
            <ul class="precio__lista">
              {m.incluye.map((x) => <li>{x}</li>)}
              {m.excluye.map((x) => <li class="precio__no">{x}</li>)}
            </ul>
            <a class="boton boton--primario" href={SITE.formularioAfiliacion} target="_blank" rel="noopener">
              {t('participa.formulario')} ↗
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donaciones -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('participa.donaciones')}</h2>
        <p class="entradilla">{donacionesIntro}</p>
      </div>
      <div class="rejilla rejilla--3">
        {donaciones.map((d) => (
          <div class="panel">
            <h3>{d.titulo}</h3>
            <p class="pieza-pequena mb-0">{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
