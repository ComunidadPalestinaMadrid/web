---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ETIQUETA_TIPO, CLASE_TIPO, type Publicacion } from '../../data/publicaciones';
import { SITE } from '../../data/site';
import { useTranslations, localizePath, formatFecha, withBase, absoluteUrl, rewriteAssetUrls } from '../../i18n/utils';

interface Props { pub: Publicacion; relacionadas: Publicacion[]; }
const { pub, relacionadas } = Astro.props;
const t = useTranslations();
const f = formatFecha(pub.date);
const esAntigua = pub.originalUrl && !pub.originalUrl.includes(SITE.dominio);
---
<BaseLayout title={pub.title} description={pub.resumen} image={pub.portada}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: pub.title,
    datePublished: pub.date,
    inLanguage: 'es',
    publisher: { '@type': 'Organization', name: SITE.nombre },
    image: pub.portada ? absoluteUrl(withBase(pub.portada)) : undefined
  })} />
  <section class="pagina-cabecera">
    <div class="contenedor">
      <nav class="migas" aria-label="Migas de pan">
        <a href={localizePath('/')}>{t('nav.inicio')}</a> /
        <a href={localizePath('/publicaciones')}>{t('pub.titulo')}</a> /
        <a href={localizePath('/publicaciones/tipo/' + pub.tipo)}>{t(ETIQUETA_TIPO[pub.tipo])}</a>
      </nav>
      <div class="articulo-cabecera">
        <span class={'etiqueta ' + CLASE_TIPO[pub.tipo]}>{t(ETIQUETA_TIPO[pub.tipo])}</span>
        <h1>{pub.title}</h1>
        <div class="meta">
          <span>{t('common.publicadoEl')} {f}</span>
          {pub.categorias.length > 0 && <span>{t('common.categoria')}: {pub.categorias.join(', ')}</span>}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos-columnas">
      <article class="prosa" set:html={rewriteAssetUrls(pub.html)} />

      <aside>
        <div class="panel panel--sticky">
          <h3>{t('pub.archivo')}</h3>
          <p class="pieza-pequena texto-suave">
            {'Esta publicación procede del archivo histórico de la asociación (2017-2024).'}
          </p>
          <ul class="lista-enlaces pieza-pequena">
            {esAntigua && (
              <li><a href={pub.originalUrl} rel="noopener" target="_blank">{t('common.webAntigua')} ↗</a></li>
            )}
            <li><a href={localizePath('/publicaciones')}>{t('common.volver')}</a></li>
          </ul>
          {relacionadas.length > 0 && (
            <>
              <h3 class="mt-3">{t('common.ultimasPublicaciones')}</h3>
              <ul class="lista-enlaces pieza-pequena">
                {relacionadas.map((r) => (
                  <li><a href={localizePath('/publicaciones/' + r.slug)}>{r.title}</a></li>
                ))}
              </ul>
            </>
          )}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
