---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import TarjetaEvento from '../TarjetaEvento.astro';
import TarjetaEfemeride from '../TarjetaEfemeride.astro';
import { proximosEventos, efemeridesProximas } from '../../data/eventos';
import { useTranslations, localizePath, withBase } from '../../i18n/utils';

const t = useTranslations();
const actividades = proximosEventos();
const efemerides = efemeridesProximas();
const hayDemo = actividades.some((e) => e.prueba);
---
<BaseLayout title={t('cal.titulo')} description={t('cal.intro')}>
  <PaginaCabecera
    eyebrow={t('nav.calendario')}
    titulo={t('cal.titulo')}
    entradilla={t('cal.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/') }, { texto: t('cal.titulo') }]}
  />

  <!-- Actividades: convocatorias con fecha, lugar y cartel -->
  <section class="seccion">
    <div class="contenedor">
      {hayDemo && <div class="aviso mb-3">{t('cal.notaDemo')}</div>}
      <div class="seccion-cabecera">
        <h2>{t('cal.actividades')}</h2>
      </div>
      {actividades.length > 0 ? (
        <div class="rejilla rejilla--2">
          {actividades.map((e) => <TarjetaEvento evento={e} />)}
        </div>
      ) : (
        <p class="texto-suave">{t('cal.sinActividades')}</p>
      )}
      <p class="mt-3"><a class="boton boton--fantasma" href={withBase('/calendario.ics')} download>{t('cal.descargarIcs')}</a></p>
    </div>
  </section>

  <!-- Efemerides: conmemoraciones anuales, listadas como enlaces con fecha -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('cal.efemerides')}</h2>
        <p class="entradilla">{t('cal.efemeridesIntro')}</p>
      </div>
      <ul class="efemerides">
        {efemerides.map(({ efemeride }) => <TarjetaEfemeride efemeride={efemeride} />)}
      </ul>
    </div>
  </section>
</BaseLayout>
