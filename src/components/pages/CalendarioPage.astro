---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaCabecera from '../PaginaCabecera.astro';
import TarjetaEvento from '../TarjetaEvento.astro';
import TarjetaEfemeride from '../TarjetaEfemeride.astro';
import { proximosEventos, efemeridesProximas } from '../../data/eventos';
import { SITE } from '../../data/site';
import { useTranslations, localizePath, withBase, absoluteUrl } from '../../i18n/utils';

const t = useTranslations();
const actividades = proximosEventos();
const efemerides = efemeridesProximas();
const hayDemo = actividades.some((e) => e.prueba);

/** Desfase horario de Madrid en una fecha dada: +01:00 en invierno, +02:00 en verano. */
function desfaseMadrid(iso: string): string {
  const partes = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Madrid', timeZoneName: 'longOffset' })
    .formatToParts(new Date(iso + 'T12:00:00Z'));
  const nombre = partes.find((p) => p.type === 'timeZoneName')?.value ?? 'GMT+01:00';
  return nombre.replace('GMT', '') || '+00:00';
}

/* Datos estructurados: cada actividad como Event, para que Google pueda
   mostrarlas con fecha y lugar en los resultados. */
const eventosJsonLd = actividades.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Actividades de la ' + SITE.corto,
  itemListElement: actividades.map((e, i) => {
    const desfase = desfaseMadrid(e.fecha);
    const inicio = e.fecha + 'T' + (e.hora || '12:00') + ':00' + desfase;
    // Google pide siempre endDate: si el acto no declara hora de fin se estima en dos horas.
    const [h, m] = (e.hora || '12:00').split(':').map(Number);
    const fin = e.horaFin || String((h + 2) % 24).padStart(2, '0') + ':' + String(m).padStart(2, '0');
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Event',
        name: e.titulo,
        startDate: inicio,
        endDate: e.fecha + 'T' + fin + ':00' + desfase,
        description: e.descripcion,
        // Si el acto no tiene cartel se usa la imagen generica del sitio.
        image: absoluteUrl(withBase(e.imagen || '/images/og-default.jpg')),
        location: {
          '@type': 'Place',
          name: e.lugar,
          address: { '@type': 'PostalAddress', addressLocality: SITE.ciudad, addressCountry: 'ES' }
        },
        eventStatus: 'https://schema.org/EventScheduled',
        organizer: { '@type': 'Organization', name: SITE.nombre, url: absoluteUrl('/') },
        performer: { '@type': 'Organization', name: SITE.nombre, url: absoluteUrl('/') },
        ...(e.precio !== undefined
          ? {
              offers: {
                '@type': 'Offer',
                price: String(e.precio),
                priceCurrency: 'EUR',
                availability: 'https://schema.org/InStock',
                url: absoluteUrl(withBase('/calendario/' + e.id))
              }
            }
          : {})
      }
    };
  })
} : null;
---
<BaseLayout title={t('cal.titulo')} description={t('cal.intro')}>
  {eventosJsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventosJsonLd)} />}
  <PaginaCabecera
    eyebrow={t('nav.calendario')}
    titulo={t('cal.titulo')}
    entradilla={t('cal.intro')}
    migas={[{ texto: t('nav.inicio'), href: localizePath('/') }, { texto: t('cal.titulo') }]}
  />

  <!-- Actividades: convocatorias con fecha, lugar y cartel -->
  <section class="seccion">
    <div class="contenedor">
      {hayDemo && <div class="aviso mb-3">{t('cal.notaDemo')}</div>}
      <div class="seccion-cabecera">
        <h2>{t('cal.actividades')}</h2>
      </div>
      {actividades.length > 0 ? (
        <div class="rejilla rejilla--2">
          {actividades.map((e) => <TarjetaEvento evento={e} />)}
        </div>
      ) : (
        <p class="texto-suave">{t('cal.sinActividades')}</p>
      )}
      <p class="mt-3"><a class="boton boton--fantasma" href={withBase('/calendario.ics')} download>{t('cal.descargarIcs')}</a></p>
    </div>
  </section>

  <!-- Efemerides: conmemoraciones anuales, listadas como enlaces con fecha -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <h2>{t('cal.efemerides')}</h2>
        <p class="entradilla">{t('cal.efemeridesIntro')}</p>
      </div>
      <ul class="efemerides">
        {efemerides.map(({ efemeride }) => <TarjetaEfemeride efemeride={efemeride} />)}
      </ul>
    </div>
  </section>
</BaseLayout>
