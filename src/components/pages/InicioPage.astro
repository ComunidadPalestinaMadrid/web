---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaPublicacion from '../TarjetaPublicacion.astro';
import TarjetaEvento from '../TarjetaEvento.astro';
import TarjetaEfemeride from '../TarjetaEfemeride.astro';
import { SITE } from '../../data/site';
import { CAMPANA, euros } from '../../data/campana';
import { ultimas } from '../../data/publicaciones';
import { proximosEventos, efemeridesProximas } from '../../data/eventos';
import { useTranslations, localizePath, withBase } from '../../i18n/utils';

const t = useTranslations();
const eventos = proximosEventos(3);
/* Con un solo acto a la vista, las efemérides pasan a la columna de al lado;
   sin actos, la sección se queda solo con ellas. */
const unSoloEvento = eventos.length === 1;
const sinEventos = eventos.length === 0;

/* --- Destacado de la campana --------------------------------------------- */
const eur = euros;
/* Misma logica que en la pagina de la campana: la escala crece si se supera el optimo */
const escalaCampana = Math.max(CAMPANA.objetivoOptimo, CAMPANA.recaudado);
const pctCampana = (CAMPANA.recaudado / escalaCampana) * 100;
const pctMinimoCampana = (CAMPANA.objetivoMinimo / escalaCampana) * 100;
const pctOptimoCampana = (CAMPANA.objetivoOptimo / escalaCampana) * 100;
const hayExtraCampana = CAMPANA.recaudado > CAMPANA.objetivoOptimo;
const fechaLimiteCampana = new Date(CAMPANA.fechaLimite + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });

const efemerides = efemeridesProximas().slice(0, 4);

// Parrilla de portada: 2 posts grandes + 6 pequenos
const posts = ultimas(8);
const grandes = posts.slice(0, 2);
const pequenos = posts.slice(2, 8);

const coleIntro = 'El Cole Árabe es el proyecto educativo de la asociación, un espacio donde infancia y adolescencia aprenden la lengua árabe, descubren sus raíces y fortalecen vínculos con la cultura y la historia palestina. A través del aprendizaje, el juego, la música y la convivencia fomentamos la transmisión de nuestra identidad cultural.';

const coleActividades = [
  { titulo: 'Clases de árabe', texto: 'Lectoescritura, gramática y conversación, en grupos por edad y nivel.' },
  { titulo: 'Talleres culturales', texto: 'Bordado, dabke, cocina y manualidades para las fechas señaladas.' },
  { titulo: 'Celebraciones', texto: 'Ramadán, Eid, Día de la Tierra y otras fiestas de la comunidad.' },
  { titulo: 'Apoyo escolar', texto: 'Refuerzo y acompañamiento en las tareas del colegio.' }
];
---
<BaseLayout>
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={withBase('/images/campana/jumbo-960.webp') + ' 960w, ' + withBase('/images/campana/jumbo-1920.webp') + ' 1920w'}
    imagesizes="100vw"
  />
  <!-- Campaña destacada -->
  <section class="jumbo">
    <img
      class="jumbo__fondo"
      srcset={withBase('/images/campana/jumbo-960.webp') + ' 960w, ' + withBase('/images/campana/jumbo-1920.webp') + ' 1920w'}
      sizes="100vw"
      src={withBase('/images/campana/jumbo-1920.webp')}
      alt=""
      aria-hidden="true"
      width="1920"
      height="1195"
      fetchpriority="high"
      decoding="async"
    />
    <div class="jumbo__velo" aria-hidden="true"></div>
    <div class="contenedor jumbo__grid">
      <div class="jumbo__texto">
        <h1 class="jumbo__titulo">{CAMPANA.tituloCorto}</h1>
        <p class="jumbo__sub">{CAMPANA.subtitulo}</p>
        <p class="jumbo__plazo">¡Solo hasta el {fechaLimiteCampana}!</p>
        <div class="jumbo__recaudacion">
          <p class="jumbo__cifra">{eur(CAMPANA.recaudado)} <span class="jumbo__de">de {eur(CAMPANA.objetivoMinimo)}</span></p>
          <div class="jumbo__barra" aria-hidden="true">
            <span class={'jumbo__relleno' + (hayExtraCampana ? ' jumbo__relleno--extra' : '')} style={`width: ${pctOptimoCampana.toFixed(2)}%`}></span>
            {hayExtraCampana && (
              <span
                class="jumbo__extra"
                style={`left: ${pctOptimoCampana.toFixed(2)}%; width: ${(pctCampana - pctOptimoCampana).toFixed(2)}%`}
              ></span>
            )}
            <i class="jumbo__marca" style={`left: ${pctMinimoCampana.toFixed(2)}%`}></i>
            {hayExtraCampana && <i class="jumbo__marca jumbo__marca--optimo" style={`left: ${pctOptimoCampana.toFixed(2)}%`}></i>}
          </div>
          <p class="jumbo__leyenda">Mínimo {eur(CAMPANA.objetivoMinimo)} · óptimo {eur(CAMPANA.objetivoOptimo)}</p>
        </div>
        <a class="boton boton--primario jumbo__cta" href={localizePath('/reencuentrosquesalvanvidas')}>Dona ahora</a>
      </div>
    </div>
  </section>

  <!-- Parrilla de posts: 2 grandes + 6 pequenos -->
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <span class="eyebrow">{t('common.ultimasPublicaciones')}</span>
        <h2>{t('pub.titulo')}</h2>
      </div>
      <div class="parrilla-posts">
        <div class="parrilla-posts__grandes">
          {grandes.map((p) => <TarjetaPublicacion pub={p} variante="grande" />)}
        </div>
        <div class="parrilla-posts__pequenos">
          {pequenos.map((p) => <TarjetaPublicacion pub={p} variante="pequeno" />)}
        </div>
      </div>
      <p class="mt-3">
        <a class="boton boton--fantasma" href={localizePath('/publicaciones')}>{t('common.verMasPublicaciones')} →</a>
      </p>
    </div>
  </section>

  <!-- Cole Arabe -->
  <section class="seccion seccion--ambar">
    <div class="contenedor cole-bloque">
      <div>
        <span class="eyebrow">{t('nav.actividades')}</span>
        <h2>{t('nav.cole')}</h2>
        <p>{coleIntro}</p>
        <ul class="lista-actividades">
          {coleActividades.map((a) => (
            <li><strong>{a.titulo}</strong>{a.texto}</li>
          ))}
        </ul>
        <a class="boton boton--primario" href={localizePath('/cole-arabe')}>{t('common.leerMas')} →</a>
      </div>
      <div class="cole-fotos">
        <img src={withBase('/images/uploads/cole-1.jpg')} alt={'Taller de manualidades del Cole Árabe'} loading="lazy" decoding="async" />
        <img src={withBase('/images/uploads/cole-2.webp')} alt={'Dibujos del alumnado del Cole Árabe'} loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Agenda -->
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <span class="eyebrow">{t('home.eventosTitulo')}</span>
        <h2>{t('cal.agenda')}</h2>
      </div>
      {sinEventos ? (
        <>
          <h3 class="subtitulo-agenda">{t('cal.efemerides')}</h3>
          <ul class="efemerides">
            {efemerides.map(({ efemeride }) => <TarjetaEfemeride efemeride={efemeride} />)}
          </ul>
        </>
      ) : unSoloEvento ? (
        <div class={'agenda-doble' + (eventos[0].imagen ? '' : ' agenda-doble--sin-cartel')}>
          {eventos[0].imagen && (
            <figure class="agenda-doble__cartel">
              <img src={withBase(eventos[0].imagen)} alt={'Cartel del evento'} loading="lazy" decoding="async" />
            </figure>
          )}
          <TarjetaEvento evento={eventos[0]} soloCuerpo />
        </div>
      ) : (
        <>
          <h3 class="subtitulo-agenda">{t('cal.actividades')}</h3>
          <div class="rejilla rejilla--2">
            {eventos.map((e) => <TarjetaEvento evento={e} />)}
          </div>
          <h3 class="subtitulo-agenda">{t('cal.efemerides')}</h3>
          <ul class="efemerides">
            {efemerides.map(({ efemeride }) => <TarjetaEfemeride efemeride={efemeride} />)}
          </ul>
        </>
      )}
      <p class="mt-3"><a class="boton boton--fantasma" href={localizePath('/calendario')}>{t('common.verMasEventos')} →</a></p>
    </div>
  </section>

  <section class="seccion seccion--suave">
    <div class="contenedor dos-columnas">
      <div>
        <span class="eyebrow">{t('home.sobreTitulo')}</span>
        <h2>{SITE.nombre}</h2>
        <p>
          {'La Comunidad Hispano Palestina Jerusalén es una asociación sin ánimo de lucro fundada en 1988 en Madrid. Trabajamos para visibilizar la causa palestina y apoyar a la comunidad palestina en España.'}
        </p>
        <a class="boton boton--fantasma" href={localizePath('/quienes-somos')}>{t('nav.quienes')} →</a>
      </div>
      <div class="panel panel--verde">
        <h3>{t('home.escribenos')}</h3>
        <p class="pieza-pequena">{t('home.tarjetaContactoTexto')}</p>
        <ul class="lista-enlaces pieza-pequena">
          <li><a href={'mailto:' + SITE.emails.asociacion}>{SITE.emails.asociacion}</a></li>
          <li><a href={'mailto:' + SITE.emails.cole}>{SITE.emails.cole}</a></li>
          <li><a href={SITE.instagram.url} rel="noopener" target="_blank">{SITE.instagram.usuario}</a></li>
        </ul>
        <a class="boton boton--verde" href={localizePath('/contacto')}>{t('nav.contacto')} →</a>
      </div>
    </div>
  </section>
</BaseLayout>
