---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaPublicacion from '../TarjetaPublicacion.astro';
import TarjetaEvento from '../TarjetaEvento.astro';
import { SITE } from '../../data/site';
import { ultimas } from '../../data/publicaciones';
import { proximosEventos, tituloEvento } from '../../data/eventos';
import { useTranslations, localizePath, withBase, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const eventos = proximosEventos(3);

// Parrilla de portada: 2 posts grandes + 6 pequenos
const posts = ultimas(8);
const grandes = posts.slice(0, 2);
const pequenos = posts.slice(2, 8);

const coleIntro = ar
  ? 'المدرسة العربية هي المشروع التربوي للجمعية. نجتمع كل أسبوع لتعلّم اللغة العربية والحفاظ على الثقافة الفلسطينية مع أطفال الجالية.'
  : 'El Cole Árabe es el proyecto educativo de la asociación. Cada semana nos reunimos para aprender árabe y mantener viva la cultura palestina con las niñas y los niños de la comunidad.';

const coleActividades = ar ? [
  { titulo: 'دروس اللغة العربية', texto: 'القراءة والكتابة والقواعد والمحادثة، في مجموعات حسب العمر والمستوى.' },
  { titulo: 'ورشات ثقافية', texto: 'التطريز والدبكة والمطبخ والأشغال اليدوية في المناسبات.' },
  { titulo: 'الاحتفالات', texto: 'رمضان والعيد ويوم الأرض وأعياد الجالية الأخرى.' },
  { titulo: 'الدعم المدرسي', texto: 'متابعة دراسية ودعم في الواجبات المدرسية.' }
] : [
  { titulo: 'Clases de árabe', texto: 'Lectoescritura, gramática y conversación, en grupos por edad y nivel.' },
  { titulo: 'Talleres culturales', texto: 'Bordado, dabke, cocina y manualidades para las fechas señaladas.' },
  { titulo: 'Celebraciones', texto: 'Ramadán, Eid, Día de la Tierra y otras fiestas de la comunidad.' },
  { titulo: 'Apoyo escolar', texto: 'Refuerzo y acompañamiento en las tareas del colegio.' }
];
---
<BaseLayout lang={lang}>
  <section class="hero">
    <img
      class="hero__fondo"
      src={withBase('/images/uploads/2023-10-15-manifestacion.jpg')}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__velo" aria-hidden="true"></div>
    <div class="contenedor hero__grid">
      <div>
        <h1 class="hero__titulo">{t('home.titulo')}</h1>
        <p class="hero__texto">{t('home.texto')}</p>
        <div class="boton-fila">
          <a class="boton boton--primario" href={localizePath('/publicaciones', lang)}>{t('home.ctaPublicaciones')}</a>
          <a class="boton boton--fantasma" href={localizePath('/calendario', lang)}>{t('home.ctaCalendario')}</a>
        </div>
      </div>
      <div class="hero__panel">
        <h3>{t('common.proximosEventos')}</h3>
        <ul class="lista-enlaces">
          {eventos.map((e) => (
            <li>
              <a href={localizePath('/calendario', lang)}>
                <strong>{tituloEvento(e, lang)}</strong>
              </a>
              <div class="pieza-pequena texto-suave">
                {new Date(e.fecha + 'T12:00:00').toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                {e.hora ? ' · ' + e.hora : ''}
              </div>
            </li>
          ))}
        </ul>
        <a class="boton boton--texto" href={localizePath('/calendario', lang)}>{t('common.verMasEventos')} →</a>
      </div>
    </div>
  </section>

  <!-- Parrilla de posts: 2 grandes + 6 pequenos -->
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <span class="eyebrow">{t('common.ultimasPublicaciones')}</span>
        <h2>{t('pub.titulo')}</h2>
      </div>
      <div class="parrilla-posts">
        <div class="parrilla-posts__grandes">
          {grandes.map((p) => <TarjetaPublicacion pub={p} lang={lang} variante="grande" />)}
        </div>
        <div class="parrilla-posts__pequenos">
          {pequenos.map((p) => <TarjetaPublicacion pub={p} lang={lang} variante="pequeno" />)}
        </div>
      </div>
      <p class="mt-3">
        <a class="boton boton--fantasma" href={localizePath('/publicaciones', lang)}>{t('common.verMasPublicaciones')} →</a>
      </p>
    </div>
  </section>

  <!-- Cole Arabe -->
  <section class="seccion seccion--suave">
    <div class="contenedor cole-bloque">
      <div>
        <span class="eyebrow">{t('nav.actividades')}</span>
        <h2>{t('nav.cole')}</h2>
        <p>{coleIntro}</p>
        <ul class="lista-actividades">
          {coleActividades.map((a) => (
            <li><strong>{a.titulo}</strong>{a.texto}</li>
          ))}
        </ul>
        <a class="boton boton--primario" href={localizePath('/cole-arabe', lang)}>{t('common.leerMas')} →</a>
      </div>
      <div class="cole-fotos">
        <img src={withBase('/images/uploads/cole-1.jpg')} alt={ar ? 'ورشة أشغال يدوية في المدرسة العربية' : 'Taller de manualidades del Cole Árabe'} loading="lazy" decoding="async" />
        <img src={withBase('/images/uploads/cole-2.jpg')} alt={ar ? 'رسومات الأطفال في المدرسة العربية' : 'Dibujos del alumnado del Cole Árabe'} loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Agenda -->
  <section class="seccion">
    <div class="contenedor">
      <div class="seccion-cabecera">
        <span class="eyebrow">{t('home.eventosTitulo')}</span>
        <h2>{t('cal.agenda')}</h2>
      </div>
      <div class="rejilla rejilla--2">
        {eventos.map((e) => <TarjetaEvento evento={e} lang={lang} />)}
      </div>
      <p class="mt-3"><a class="boton boton--fantasma" href={localizePath('/calendario', lang)}>{t('common.verMasEventos')} →</a></p>
    </div>
  </section>

  <section class="seccion seccion--suave">
    <div class="contenedor dos-columnas">
      <div>
        <span class="eyebrow">{t('home.sobreTitulo')}</span>
        <h2>{SITE.nombre}</h2>
        <p>
          {ar
            ? 'جمعية الجالية الإسبانية الفلسطينية – القدس جمعية غير ربحية تأسست عام 1988 في مدريد. نعمل على التعريف بقضية فلسطين ودعم المجتمع الفلسطيني في إسبانيا.'
            : 'La Asociación de la Comunidad Hispano Palestina Jerusalén es una asociación sin ánimo de lucro fundada en 1988 en Madrid. Trabajamos para visibilizar la causa palestina y apoyar a la comunidad palestina en España.'}
        </p>
        <a class="boton boton--fantasma" href={localizePath('/quienes-somos', lang)}>{t('nav.quienes')} →</a>
      </div>
      <div class="panel panel--verde">
        <h3>{t('home.escribenos')}</h3>
        <p class="pieza-pequena">{t('home.tarjetaContactoTexto')}</p>
        <ul class="lista-enlaces pieza-pequena">
          <li><a href={'mailto:' + SITE.emails.asociacion}>{SITE.emails.asociacion}</a></li>
          <li><a href={'mailto:' + SITE.emails.cole}>{SITE.emails.cole}</a></li>
          <li><a href={SITE.instagram.url} rel="noopener" target="_blank">{SITE.instagram.usuario}</a></li>
        </ul>
        <a class="boton boton--verde" href={localizePath('/contacto', lang)}>{t('nav.contacto')} →</a>
      </div>
    </div>
  </section>
</BaseLayout>
