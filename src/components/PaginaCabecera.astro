---
import { absoluteUrl } from '../i18n/utils';

interface Props { eyebrow?: string; titulo: string; entradilla?: string; migas?: { texto: string; href?: string }[]; }
const { eyebrow, titulo, entradilla, migas } = Astro.props;

/* Datos estructurados de las migas de pan (Google las muestra en el resultado). */
const jsonLd = migas && migas.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: migas.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.texto,
        ...(m.href ? { item: absoluteUrl(m.href) } : {})
      }))
    }
  : null;
---
<section class="pagina-cabecera">
  <div class="contenedor">
    {migas && migas.length > 0 && (
      <nav class="migas" aria-label="Migas de pan">
        {migas.map((m, i) => (
          <span>{i > 0 && ' / '}{m.href ? <a href={m.href}>{m.texto}</a> : m.texto}</span>
        ))}
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{titulo}</h1>
    {entradilla && <p class="entradilla">{entradilla}</p>}
  </div>
</section>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
