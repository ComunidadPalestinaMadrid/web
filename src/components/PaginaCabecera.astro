---
import { absoluteUrl, localizePath, currentPath } from '../i18n/utils';

interface Props {
  eyebrow?: string;
  titulo: string;
  entradilla?: string;
  migas?: { texto: string; href?: string }[];
  /** Quita la linea inferior de la cabecera */
  sinFilete?: boolean;
}
const { eyebrow, titulo, entradilla, migas, sinFilete = false } = Astro.props;

/* Datos estructurados de las migas de pan (Google las muestra en el resultado).
   Google exige el campo `item` en TODOS los ListItem: el ultimo nivel, que es la
   pagina actual, se rellena con su propia URL. */
const rutaActual = localizePath(currentPath(Astro.url));
const jsonLd = migas && migas.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: migas.map((m, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: m.texto,
        item: absoluteUrl(m.href ?? rutaActual)
      }))
    }
  : null;
---
<section class={'pagina-cabecera' + (sinFilete ? ' pagina-cabecera--sin-filete' : '')}>
  <div class="contenedor">
    {migas && migas.length > 0 && (
      <nav class="migas" aria-label="Migas de pan">
        {migas.map((m, i) => (
          <span>{i > 0 && ' / '}{m.href ? <a href={m.href}>{m.texto}</a> : m.texto}</span>
        ))}
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <div class="pagina-cabecera__fila">
      <h1>{titulo}</h1>
      <slot />
    </div>
    {entradilla && <p class="entradilla">{entradilla}</p>}
  </div>
</section>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
