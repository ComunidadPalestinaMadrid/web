---
// Tipografias autoalojadas (subconjunto latin, sin peticiones a Google)
import '@fontsource/barlow-condensed/latin-400.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-700.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { currentPath, localizePath, useTranslations, withBase, absoluteUrl } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen de previsualizacion (por defecto, la del inicio) */
  image?: string;
  /** Tipo Open Graph: 'website' (por defecto) o 'article' */
  tipo?: 'website' | 'article';
  /** Fecha ISO de publicacion, para article:published_time */
  fecha?: string;
  /** Seccion o categoria, para article:section */
  seccion?: string;
}
const { title, description, image, tipo = 'website', fecha, seccion } = Astro.props;
const t = useTranslations();
const canonical = absoluteUrl(localizePath(currentPath(Astro.url)));

/* --- TITULO ---------------------------------------------------------------
   Google corta alrededor de 60 caracteres. El sufijo con la marca son 32, asi
   que solo se anade cuando cabe; si no, se publica el titular solo, y si aun
   asi se pasa, se recorta por palabra. */
const MAX_TITULO = 60;
function recortar(texto: string, max: number): string {
  if (texto.length <= max) return texto;
  const corte = texto.slice(0, max - 1);
  const espacio = corte.lastIndexOf(' ');
  const limpio = (espacio > max * 0.55 ? corte.slice(0, espacio) : corte).replace(/[\s,;:.·—-]+$/, '');
  return limpio + '…';
}
function componerTitulo(pagina?: string): string {
  if (!pagina) return SITE.corto;
  const completo = pagina + ' · ' + SITE.corto;
  if (completo.length <= MAX_TITULO) return completo;
  if (pagina.length <= MAX_TITULO) return pagina;
  return recortar(pagina, MAX_TITULO);
}
const titulo = componerTitulo(title);

/* --- DESCRIPCION: se recorta a ~155 caracteres por palabra --- */
const DESCRIPCION_DEFECTO = 'Comunidad Hispano Palestina Jerusalén: publicaciones, eventos, Cole Árabe y solidaridad con el pueblo palestino desde Madrid.';
const desc = recortar((description ?? DESCRIPCION_DEFECTO).replace(/\s+/g, ' ').trim(), 155);

/* --- Imagen de previsualizacion (Open Graph / Twitter / Telegram) ---
   Por defecto, una imagen 1200x630 (ratio 1.91:1) hecha con la foto del inicio:
   una imagen cuadrada o pequena, como el logo, no genera vista previa grande. */
const OG_DEFECTO = { ruta: '/images/og-default.jpg', ancho: 1200, alto: 630 };
const OG_ALT_DEFECTO = 'Manifestación por Palestina en Madrid: pancarta de «Viva la Resistencia Palestina» y banderas palestinas';
const ogRuta = image || OG_DEFECTO.ruta;
const ogUrl = absoluteUrl(withBase(ogRuta));
const ogAlt = image ? titulo : OG_ALT_DEFECTO;
const extension = ogRuta.split('.').pop()?.toLowerCase();
const ogMime = extension === 'png' ? 'image/png' : extension === 'webp' ? 'image/webp' : 'image/jpeg';

let ogAncho: number | undefined = image ? undefined : OG_DEFECTO.ancho;
let ogAlto: number | undefined = image ? undefined : OG_DEFECTO.alto;
if (image) {
  try {
    const { default: sharp } = await import('sharp');
    const meta = await sharp('public' + ogRuta).metadata();
    ogAncho = meta.width;
    ogAlto = meta.height;
  } catch {
    /* si no se puede leer, se omiten las dimensiones */
  }
}

/* --- DATOS ESTRUCTURADOS: organizacion y sitio --- */
const RAIZ = absoluteUrl('/');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': RAIZ + '#organizacion',
      name: SITE.nombre,
      alternateName: SITE.corto,
      url: RAIZ,
      logo: {
        '@type': 'ImageObject',
        url: absoluteUrl(withBase('/images/logo-512.webp')),
        width: 512,
        height: 512
      },
      email: SITE.emails.asociacion,
      sameAs: [SITE.instagram.url],
      foundingDate: String(SITE.fundacion),
      taxID: SITE.cif,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.domicilio,
        addressLocality: SITE.ciudad,
        addressCountry: 'ES'
      }
    },
    {
      '@type': 'WebSite',
      '@id': RAIZ + '#web',
      url: RAIZ,
      name: SITE.corto,
      inLanguage: 'es',
      publisher: { '@id': RAIZ + '#organizacion' }
    }
  ]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph (Telegram, WhatsApp, Facebook, LinkedIn, Slack...) -->
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content={ogMime} />
    {ogAncho && ogAlto && <meta property="og:image:width" content={String(ogAncho)} />}
    {ogAncho && ogAlto && <meta property="og:image:height" content={String(ogAlto)} />}
    <meta property="og:image:alt" content={ogAlt} />
    {tipo === 'article' && fecha && <meta property="article:published_time" content={fecha} />}
    {tipo === 'article' && seccion && <meta property="article:section" content={seccion} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenido">{t('common.irAlContenido')}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
